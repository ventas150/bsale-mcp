# Bsale MCP - Environment variables
# Copiar a .env (local) o setear en Render Dashboard -> Environment

# ----- Bsale (requerido) -----
BSALE_ACCESS_TOKEN=tu_token_de_bsale_aqui
BSALE_BASE_URL=https://api.bsale.io
BSALE_TIMEOUT=30
BSALE_DEFAULT_LIMIT=25
BSALE_MAX_RETRIES=3
BSALE_CACHE_TTL_SECONDS=900

# ----- Shopify (opcional - habilita el lado Shopify de bsale_boletas_vs_shopify) -----
# Token de Admin API con read_orders + read_merchant_managed_fulfillment_orders.
# SHOPIFY_SHOP=vxmq1u-eq.myshopify.com
# SHOPIFY_ADMIN_TOKEN=shpat_xxx
# SHOPIFY_API_VERSION=2025-07

# ----- Logging -----
LOG_LEVEL=INFO

# ----- Cache -----
CACHE_DIR=/tmp/bsale_cache

# ----- Audit log -----
AUDIT_DIR=/tmp/bsale_audit
AUDIT_DEFAULT_ACTOR=bsale-mcp

# ----- Postgres (opcional - habilita snapshots y mapping cross-source) -----
# Render Postgres lo provee automaticamente al linkear DB con el servicio
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ----- Retencion (la aplica el cron sync_incremental en cada corrida) -----
# Meses que documents_snapshot.raw conserva la ficha del cliente (nombre, RUT,
# correo, direccion). Pasado el plazo se minimiza a los campos de negocio; la
# fila y la venta oficial quedan. 0 = apagado (kill-switch, no politica).
RAW_RETENTION_MONTHS=6
RAW_RETENTION_BATCH_ROWS=5000
RETENTION_MAX_LOTES=20

# ----- Scheduler (opcional - corre snapshots nocturnos) -----
ENABLE_SCHEDULER=0

# ----- Sentry (opcional) -----
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
SENTRY_TRACES_SAMPLE=0.1
ENVIRONMENT=production
RELEASE_VERSION=0.2.0
