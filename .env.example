# Bsale MCP - Environment variables
# Copiar a .env (local) o setear en Render Dashboard -> Environment

# ----- Bsale (requerido) -----
BSALE_ACCESS_TOKEN=tu_token_de_bsale_aqui
BSALE_BASE_URL=https://api.bsale.io
BSALE_TIMEOUT=30
BSALE_DEFAULT_LIMIT=25
BSALE_MAX_RETRIES=3
BSALE_CACHE_TTL_SECONDS=900

# ----- Logging -----
LOG_LEVEL=INFO

# ----- Cache -----
CACHE_DIR=/tmp/bsale_cache

# ----- Audit log -----
AUDIT_DIR=/tmp/bsale_audit
AUDIT_DEFAULT_ACTOR=bsale-mcp

# ----- Postgres (opcional - habilita snapshots y mapping cross-source) -----
# Render Postgres lo provee automaticamente al linkear DB con el servicio
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ----- Scheduler (opcional - corre snapshots nocturnos) -----
ENABLE_SCHEDULER=0

# ----- Sentry (opcional) -----
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
SENTRY_TRACES_SAMPLE=0.1
ENVIRONMENT=production
RELEASE_VERSION=0.2.0
